# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Use the DIRECT connection (host: db.<ref>.supabase.co).
# Do NOT use the transaction pooler URL (pooler.supabase.com) — migrations require a session connection.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- Gemini (free-tier availability depends on the Google AI Studio project) ---

GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_CHAT_MODEL=gemini-3.8-flash
GEMINI_REASONING_EFFORT=medium
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Keep 1536 to match the existing Postgres vector(1536) column.
GEMINI_EMBEDDING_DIMENSIONS=1536

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# The default pool allows up to 15 concurrent database connections. Tune these
# against the Supabase connection limit before increasing service concurrency.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
